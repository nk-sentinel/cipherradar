# CipherRadar Homelab Environment
# Copy to .env.homelab and fill in actual values:
#   cp deploy/.env.homelab.example deploy/.env.homelab

# --- Shared PostgreSQL (postgres-dev on dev-network) ---
CR_DB_USER=cipherradar_dev
CR_DB_PASSWORD=<your-cipherradar_dev-password>
CR_DB_NAME=cipherradar_dev

# --- Shared Redis (redis-dev on dev-network) ---
CR_REDIS_PASSWORD=<your-redis-dev-password>

# --- Application ---
CR_JWT_SECRET=<generate-a-random-secret>
CR_SKIP_ADMIN=false
CR_SEED_DATA=false
